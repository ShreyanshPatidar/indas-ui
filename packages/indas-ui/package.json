{
  "name": "indas-ui",
  "version": "0.0.1",
  "description": "Reusable React component library extracted from Indas Estimo (ERP). Tailwind + Radix + Lucide + DataGrid.",
  "license": "MIT",
  "author": "Indas Analytics Pvt Ltd",
  "contributors": [
    "Shreyansh Patidar",
    "Abhinav"
  ],
  "repository": {
