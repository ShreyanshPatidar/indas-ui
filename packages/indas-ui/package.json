{
  "name": "indas-ui",
  "version": "0.1.0",
  "description": "Indas UI — React component library for business apps: Tailwind design tokens, Radix primitives, Lucide icons, DataGrid, dashboards and charts.",
  "license": "MIT",
  "author": "Indas Analytics Pvt Ltd",
  "contributors": [
    "Shreyansh Patidar",
    "Abhinav"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShreyanshPatidar/indas-ui.git",
    "directory": "packages/indas-ui"
  },
  "homepage": "https://shreyanshpatidar.github.io/indas-ui",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./ui": {
      "types": "./dist/components/ui/index.d.ts",
      "import": "./dist/components/ui/index.js",
      "require": "./dist/cjs/components/ui/index.js"
    },
    "./layout": {
      "types": "./dist/components/layout/index.d.ts",
      "import": "./dist/components/layout/index.js",
      "require": "./dist/cjs/components/layout/index.js"
    },
    "./datagrid": {
      "types": "./dist/components/datagrid/index.d.ts",
      "import": "./dist/components/datagrid/index.js",
      "require": "./dist/cjs/components/datagrid/index.js"
    },
    "./dashboard": {
      "types": "./dist/components/dashboard/index.d.ts",
      "import": "./dist/components/dashboard/index.js",
      "require": "./dist/cjs/components/dashboard/index.js"
    },
    "./charts": {
      "types": "./dist/components/dashboard/charts/index.d.ts",
      "import": "./dist/components/dashboard/charts/index.js",
      "require": "./dist/cjs/components/dashboard/charts/index.js"
    },
    "./kpi": {
      "types": "./dist/components/dashboard/kpi/index.d.ts",
      "import": "./dist/components/dashboard/kpi/index.js",
      "require": "./dist/cjs/components/dashboard/kpi/index.js"
    },
    "./modals": {
      "types": "./dist/components/modals/index.d.ts",
      "import": "./dist/components/modals/index.js",
      "require": "./dist/cjs/components/modals/index.js"
    },
    "./forms": {
      "types": "./dist/components/forms/index.d.ts",
      "import": "./dist/components/forms/index.js",
      "require": "./dist/cjs/components/forms/index.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js",
      "require": "./dist/cjs/providers.js"
    },
    "./tokens.css": "./dist/styles/tokens.css",
    "./styles/*": "./dist/styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths && tsc -p tsconfig.build.cjs.json && tsc-alias -p tsconfig.build.cjs.json --resolve-full-paths && node scripts/copy-assets.mjs",
    "dev": "node scripts/dev.mjs",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@microsoft/signalr": "^10.0.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.10",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.12",
    "jspdf": "^3.0.2",
    "jspdf-autotable": "^5.0.2",
    "ldrs": "^1.1.9",
    "lucide-react": "^0.562.0",
    "next-auth": "^4.24.7",
    "papaparse": "^5.5.3",
    "react-hook-form": "^7.76.1",
    "react-image-crop": "^11.0.10",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "svg2pdf.js": "^2.7.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "next": "^16.2.1",
    "tsc-alias": "^1.9.4",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwind",
    "design-system",
    "datagrid",
    "indas",
    "erp"
  ],
  "typesVersions": {
    "*": {
      "ui": [
        "./dist/components/ui/index.d.ts"
      ],
      "layout": [
        "./dist/components/layout/index.d.ts"
      ],
      "datagrid": [
        "./dist/components/datagrid/index.d.ts"
      ],
      "dashboard": [
        "./dist/components/dashboard/index.d.ts"
      ],
      "charts": [
        "./dist/components/dashboard/charts/index.d.ts"
      ],
      "kpi": [
        "./dist/components/dashboard/kpi/index.d.ts"
      ],
      "modals": [
        "./dist/components/modals/index.d.ts"
      ],
      "forms": [
        "./dist/components/forms/index.d.ts"
      ],
      "providers": [
        "./dist/providers.d.ts"
      ]
    }
  }
}
